+        n = 0
+        sent = []
+        for fr in frames or []:
+            payload = fr.get("payload") or {}
+            payload = dict(payload, replay=True)
+            if self._post(("text", json.dumps(payload, ensure_ascii=False))):
+                n += 1
+                sent.append(fr.get("seq"))
+        if n and _OUTBOX is not None:
+            _OUTBOX.touch(self.task.get("channel_id"), sent)
+        return n
