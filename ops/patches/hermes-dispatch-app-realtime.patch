+"""APP 下行消息可靠投递（outbox）+ 通道令牌。
+
+问题背景：原实现下行帧只进 asyncio.Queue，APP 断线时 `if ws is None: continue`
+直接丢弃，无持久化、无补发；进程重启则全丢。老板离线期间的回复永远收不到。
+
+本模块提供：
+  1. outbox 表：下行关键帧先落库再发送，per-channel 单调 seq；
+  2. pending()：按 since_seq 取未投递帧，供 WS 重连补发与 HTTP 补拉；
+  3. ack()：客户端回执后标记 acked，避免无限重发；
+  4. gc()：清理过期记录，防止库膨胀；
+  5. 通道令牌：channels.token，WS/HTTP 校验用（渐进启用）。
+
+设计约束：
+  - 复用 dispatchd 的 sqlite 连接与锁（sqlite3 连接跨线程不安全）；
+  - 只存文本关键帧（reply/reply_end/error/transcript），音频帧不入库；
+  - 任何异常都不能影响主流程：调用方一律 try/except 兜住。
+"""
+import json
+import os
+import time
+import uuid
+
+# 需要可靠投递的帧类型：这些是老板"必须看到/听到"的内容。
+RELIABLE_KINDS = frozenset({"reply", "reply_end", "error", "transcript"})
+
+MAX_REPLAY = int(os.environ.get("DISPATCH_OUTBOX_REPLAY_MAX", "50"))
+# 补发上限只作用于"一次重连最多补多少条"，超出的仍留在库里等下次 HTTP 补拉。
+KEEP_ACKED_DAYS = int(os.environ.get("DISPATCH_OUTBOX_KEEP_DAYS", "7"))
+KEEP_PENDING_DAYS = int(os.environ.get("DISPATCH_OUTBOX_PENDING_DAYS", "30"))
+
+DDL = """
+CREATE TABLE IF NOT EXISTS outbox (
+  channel_id TEXT NOT NULL,
+  seq        INTEGER NOT NULL,          -- per-channel 单调递增，从 1 开始
+  msg_id     TEXT NOT NULL,
+  task_id    TEXT,
+  turn_no    INTEGER,
+  kind       TEXT,                      -- reply / reply_end / error / transcript
+  payload    TEXT NOT NULL,             -- 完整下行帧 JSON（含 seq）
+  status     TEXT NOT NULL DEFAULT 'pending',   -- pending / acked
+  attempts   INTEGER DEFAULT 0,         -- 已尝试投递次数（重连补发累计）
+  created_at REAL,
+  acked_at   REAL,
+  PRIMARY KEY (channel_id, seq)
+);
+CREATE INDEX IF NOT EXISTS idx_outbox_status ON outbox(status, created_at);
+"""
+
+
+class Outbox:
+    def __init__(self, db, lock):
+        self._db = db
+        self._lock = lock
+
+    # ---------------------------------------------------------------- 初始化
+    def init(self):
+        with self._lock:
+            self._db.executescript(DDL)
+            cols = [r[1] for r in self._db.execute("PRAGMA table_info(channels)")]
+            if "token" not in cols:
+                self._db.execute("ALTER TABLE channels ADD COLUMN token TEXT")
+            self._db.commit()
+
+    # ---------------------------------------------------------------- 写入
+    def append(self, channel_id, task_id, turn_no, kind, payload):
+        """落库并分配 seq，返回 (seq, body)。失败返回 (0, payload)。"""
+        if not channel_id:
+            return 0, payload
+        try:
+            with self._lock:
+                row = self._db.execute(
+                    "SELECT COALESCE(MAX(seq), 0) + 1 FROM outbox WHERE channel_id=?",
+                    (channel_id,)).fetchone()
+                seq = int(row[0] or 1)
+                body = dict(payload)
+                body["seq"] = seq
+                self._db.execute(
+                    "INSERT INTO outbox(channel_id, seq, msg_id, task_id, turn_no,"
+                    " kind, payload, status, attempts, created_at)"
+                    " VALUES(?,?,?,?,?,?,?,?,?,?)",
+                    (channel_id, seq, uuid.uuid4().hex[:16], task_id, turn_no,
+                     kind, json.dumps(body, ensure_ascii=False), "pending", 0,
+                     time.time()))
+                self._db.commit()
+                return seq, body
+        except Exception:                                    # noqa: BLE001
+            return 0, payload
+
+    # ---------------------------------------------------------------- 读取
+    def max_seq(self, channel_id):
+        try:
+            with self._lock:
+                row = self._db.execute(
+                    "SELECT COALESCE(MAX(seq), 0) FROM outbox WHERE channel_id=?",
+                    (channel_id,)).fetchone()
+            return int(row[0] or 0)
+        except Exception:                                    # noqa: BLE001
+            return 0
+
+    def pending(self, channel_id, since_seq=0, limit=MAX_REPLAY, include_acked=False):
+        """取 seq > since_seq 的帧（默认只取未 ack 的），按 seq 升序。"""
+        sql = ("SELECT seq, kind, payload, status, created_at FROM outbox"
+               " WHERE channel_id=? AND seq>?")
+        if not include_acked:
+            sql += " AND status='pending'"
+        sql += " ORDER BY seq LIMIT ?"
+        try:
+            with self._lock:
+                rows = self._db.execute(sql, (channel_id, int(since_seq or 0),
+                                              int(limit))).fetchall()
+            return [{"seq": r[0], "kind": r[1], "payload": json.loads(r[2]),
+                     "status": r[3], "created_at": r[4]} for r in rows]
+        except Exception:                                    # noqa: BLE001
+            return []
+
+    # ---------------------------------------------------------------- 回执
+    def ack(self, channel_id, seqs):
+        seqs = [int(s) for s in (seqs or []) if str(s).isdigit()]
+        if not channel_id or not seqs:
+            return 0
+        marks = ",".join("?" * len(seqs))
+        try:
+            with self._lock:
+                cur = self._db.execute(
+                    "UPDATE outbox SET status='acked', acked_at=?"
+                    " WHERE channel_id=? AND seq IN (%s) AND status!='acked'" % marks,
+                    (time.time(), channel_id, *seqs))
+                self._db.commit()
+                return cur.rowcount or 0
+        except Exception:                                    # noqa: BLE001
+            return 0
+
+    def touch(self, channel_id, seqs):
+        """重连补发计数：attempts+1，便于观察客户端到底有没有收到。"""
+        seqs = [int(s) for s in (seqs or []) if str(s).isdigit()]
+        if not channel_id or not seqs:
+            return
+        marks = ",".join("?" * len(seqs))
+        try:
+            with self._lock:
+                self._db.execute(
+                    "UPDATE outbox SET attempts=attempts+1"
+                    " WHERE channel_id=? AND seq IN (%s)" % marks,
+                    (channel_id, *seqs))
+                self._db.commit()
+        except Exception:                                    # noqa: BLE001
+            pass
+
+    # ---------------------------------------------------------------- 清理
+    def gc(self):
+        now = time.time()
+        try:
+            with self._lock:
+                a = self._db.execute(
+                    "DELETE FROM outbox WHERE status='acked' AND acked_at < ?",
+                    (now - KEEP_ACKED_DAYS * 86400,)).rowcount
+                b = self._db.execute(
+                    "DELETE FROM outbox WHERE status='pending' AND created_at < ?",
+                    (now - KEEP_PENDING_DAYS * 86400,)).rowcount
+                self._db.commit()
+            return {"acked_removed": a or 0, "pending_removed": b or 0}
+        except Exception:                                    # noqa: BLE001
+            return {"acked_removed": 0, "pending_removed": 0}
+
+    # ---------------------------------------------------------------- 鉴权
+    def channel_token(self, channel_id):
+        try:
+            with self._lock:
+                row = self._db.execute(
+                    "SELECT token FROM channels WHERE channel_id=?",
+                    (channel_id,)).fetchone()
+            return (row[0] if row else "") or ""
+        except Exception:                                    # noqa: BLE001
+            return ""
+
+    def set_channel_token(self, channel_id, token):
+        try:
