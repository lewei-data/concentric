__pycache__/
*.py[cod]
logs/
*.log
*.pid
.DS_Store
.env
.remotion/
video-remotion/node_modules/

# ---- Android 客户端工程（android/）----
# 构建缓存与 IDE 产物：跨平台无效，任何人 clone 后由 Gradle 重建
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/captures/
android/.cxx/
# 本机路径与签名凭据：绝不入库
android/local.properties
android/keystore.properties
android/signing/*.jks
android/signing/*.keystore
# 交付二进制（APK）走 Releases / 服务器留存，不入 git 历史
android/dist/*.apk

# ---- 运行时产物 / 缓存（本机生成，可重建）----
.cache/
*.pack
video-remotion/out/
android/dist/
prototype/assets/live/
# media-engine 合成产物（TTS 音频/srt/segments），按 TTL 自动清理
media-engine/work/

# ---- 备份包 / 探测残留 ----
*.tar.gz
prototype/assets/_probe.*

# ---- 媒体二进制（本机保留，不入库）----
# 运行时静态媒体：头像、肖像、开场、素材、字体
prototype/assets/motion/
prototype/assets/videos/
prototype/assets/avatars/
prototype/assets/portraits/
prototype/assets/intro/
prototype/assets/fonts/
prototype/assets/faces/
video-remotion/public/
# 成片与预览
preview/
*.mp4
*.wav
*.otf
*.jpg
*.png
# 例外：Android 启动图标必须入库，否则 Gradle 打包失败
!android/app/src/main/res/mipmap-*/ic_launcher*.png
