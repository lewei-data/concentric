# 可选：正式 release 签名证书配置。
# 用法：复制本文件为 keystore.properties（同名、无 .example 后缀），改成真实值。
# keystore.properties 与 *.jks 均已被 .gitignore 排除，不会进入仓库。
#
# 生成自测证书示例：
#   keytool -genkeypair -v -keystore signing/conring-release.jks \
#     -storepass <密码> -keypass <密码> -alias conring \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Conring,O=Boray,C=CN"
#
# 不配置本文件时，release 会回退使用 Android 默认 debug 证书，
# 生成的是「已签名、可直接安装」的自测包，不可用于正式分发。

storeFile=signing/conring-release.jks
storePassword=change-me
keyAlias=conring
keyPassword=change-me
