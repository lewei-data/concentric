<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 普通权限，安装即授予：通话音量被调到 0 时临时抬一点，保证拨号音能听到 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 保持监听：前台服务 + Android 13+ 通知 + 开机恢复 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ 包可见性：让系统 TTS 引擎可被发现（语音播报兜底用） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".EmployeeListActivity"
            android:exported="false"
            android:label="@string/employees_title" />

        <activity
            android:name=".EmployeeDetailActivity"
            android:exported="false"
            android:label="@string/employee_detail_title" />

        <!-- 0.6.0：当前进度（小秘书简报） -->
        <activity
            android:name=".ProgressActivity"
            android:exported="false"
            android:label="@string/progress_title" />

        <!-- 0.6.0：待办事项（需要拍板的事，可审批） -->
        <activity
            android:name=".TodoActivity"
            android:exported="false"
            android:label="@string/todo_title" />

        <!-- 0.6.0：实时语音通话面板（通话本体在 VoiceCallService，切页面不断） -->
        <activity
            android:name=".VoiceCallActivity"
            android:exported="false"
            android:label="@string/voice_call_title"
            android:launchMode="singleTop" />

        <service
            android:name=".VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone|dataSync" />

        <activity
            android:name=".ReportActivity"
            android:exported="false"
            android:label="@string/report_title" />

        <!-- v2.4：server 端生成的自我介绍视频（同源 HLS/MP4 流式播放） -->
        <activity
            android:name=".IntroPlayerActivity"
            android:exported="false"
            android:label="@string/intro_player_title" />

        <!-- v2.4：实时视频通话（同源 HLS Live，音视频 mux 同轨） -->
        <activity
            android:name=".LiveCallActivity"
            android:exported="false"
            android:label="@string/live_call_title" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="@string/history_title" />

        <activity
            android:name=".HistoryDetailActivity"
            android:exported="false"
            android:label="@string/history_detail_title" />

        <service
            android:name=".ListenService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 自定义文件提供者：把私有目录里的结果文件交给外部应用打开 -->
        <provider
            android:name=".ResultFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
