<?xml version="1.0" encoding="utf-8"?>
<!-- 同心圆启动图标 · 背景层：teal 渐变 + 两圈极淡同心圆底纹 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#14B7A3"
                android:endColor="#01463F"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="94dp"
        android:height="94dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>
    <item
        android:width="70dp"
        android:height="70dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
