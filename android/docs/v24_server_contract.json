{
  "endpoints": {
    "asr": {
      "url": "https://ai.boraydata.com/conring/asr/mcp",
      "tools": [
        {
          "name": "asr_transcribe",
          "description": "把一段语音转成文字。支持 base64 音频或服务器本地文件路径，返回文本、句级时间轴与置信度（confidence/low_confidence）。",
          "params": [
            "audio_base64",
            "audio_path",
            "language",
            "model",
            "initial_prompt"
          ]
        },
        {
          "name": "voice_chat",
          "description": "接收语音指令，解析完立刻回一句「收到」（如：好的老板，马上安排 / 老板稍等），同时返回 job_id；结果稍后用 voice_job 取，或推送到 callback_url。语音里点名员工（@id/姓名/工号）时，指令直接下发给该员工，由员工处理并回复。识别置信度低（或没识别出字）时不执行指令，改由大模型按该员工的情绪回一句「没听清，请再说一遍」，状态为 need_repeat。返回 text(JSON) + audio(收到/澄清语音) 两个内容块。",
          "params": [
            "audio_base64",
            "audio_path",
            "language",
            "model",
            "initial_prompt",
            "voice",
            "profile",
            "mode",
            "bandwidth_kbps",
            "avatar_id",
            "delegate",
            "callback_url",
            "wait",
            "wait_sec",
            "include_audio",
            "timeout_sec",
            "emotion",
            "clarify",
            "clarify_timeout_sec"
          ]
        },
        {
          "name": "voice_job",
          "description": "按 job_id 取语音指令的执行结果。wait_sec>0 可长轮询（最多 30 秒）。done 时返回简要语音（speech_text + audio）、详细文字（detail_text）、句级时间轴与数字人档案（照片/仿真人视频素材），供客户端解析 WAV 包络驱动口型。",
          "params": [
            "job_id",
            "wait_sec",
            "include_audio"
          ]
        },
        {
          "name": "profile",
          "description": "获取员工档案：默认返回全部员工（工号/部门/岗位/口头禅/简介/技能/形象参数/照片与仿真人视频地址/音色/Hermes profile 是否就绪）。传 id 取单人，可用 dept/project 过滤。",
          "params": [
            "id",
            "dept",
            "project",
            "include_assets"
          ]
        },
        {
          "name": "voice_avatars",
          "description": "列出可插拔的数字人播报档案（照片 + 仿真人视频素材），按 assets 目录约定自动发现。",
          "params": []
        }
      ]
    },
    "tts": {
      "url": "https://ai.boraydata.com/conring/tts/mcp",
      "tools": [
        {
          "name": "tts_list_voices",
          "description": "列出 MCP-TTS 可用音色（CosyVoice2 zero-shot 克隆，需参考音频）。",
          "params": []
        },
        {
          "name": "tts_synthesize",
          "description": "把一段中英文混排文本合成为音频，输出句级 SRT 与 segments.json 时间轴；默认同时返回 base64 wav 音频内容块。",
          "params": [
            "text",
            "voice",
            "speed",
            "out_dir",
            "stem",
            "return_audio"
          ]
        }
      ]
    },
    "mail": {
      "url": "https://ai.boraydata.com/conring/mail/ceo/mcp",
      "tools": [
        {
          "name": "mail_send",
          "description": "以本人邮箱发送内部邮件（仅限 @mail.conring.cn 域内地址）。发件人固定为本人，不可伪造；正文会自动附上姓名与岗位签名。",
          "params": [
            "to",
            "subject",
            "body",
            "cc",
            "auto_reply",
            "agent"
          ]
        },
        {
          "name": "mail_list",
          "description": "列出本人邮箱指定文件夹的邮件摘要（发件人/主题/时间/是否已读），默认 INBOX 最新 10 封，不修改任何已读状态。",
          "params": [
            "folder",
            "limit",
            "unread_only",
            "agent"
          ]
        },
        {
          "name": "mail_read",
          "description": "按 mail_list 返回的 uid 读取本人邮箱中一封邮件的正文、抄送与附件名，读后标记为已读。",
          "params": [
            "uid",
            "folder",
            "agent"
          ]
        },
        {
          "name": "mail_check",
          "description": "检查本人邮箱配置与连通性：账号、SMTP/IMAP 端口、收件箱总数与未读数。",
          "params": [
            "agent"
          ]
        }
      ]
    }
  },
