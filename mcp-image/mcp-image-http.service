[Unit]
Description=MCP Image over Streamable HTTP (0.0.0.0:9106)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=boray
Group=boray
WorkingDirectory=/opt/sefs/opc-workbench/mcp-bridge
Environment=HOME=/home/boray
Environment=PYTHONUNBUFFERED=1
Environment=OPC_IMAGE_OUT_DIR=/opt/sefs/opc-workbench/mcp-image/output
Environment=OPC_IMAGE_PUBLIC_BASE=https://ai.boraydata.com/conring/image
# 身份沿用 OPC 个人 API key：客户端在 X-Mail-Agent 携带，bridge 注入 client_key。
ExecStart=/opt/sefs/opc-workbench/mcp-bridge/venv/bin/python /opt/sefs/opc-workbench/mcp-bridge/bridge.py --name image --host 0.0.0.0 --port 9106 --cwd /opt/sefs/opc-workbench/mcp-image --identity-param client_key --identity-override --static-dir /opt/sefs/opc-workbench/mcp-image/output --static-path /assets -- /opt/sefs/opc-workbench/mcp-image/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
